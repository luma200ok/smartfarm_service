# 홈서버 이전 파일럿(이슈 #27) — deploy/home/compose.yml 용 환경변수.
# 실제 값을 채운 .env 파일은 절대 커밋하지 말 것(.gitignore 확인) — chmod 600 권장.
# 아래 값은 전부 더미/예시이며 실제 시크릿이 아니다.

# --- 호스트 데이터 루트(절대경로) — backend 이미지 볼륨이 ${DATA_DIR}/images 로 마운트됨 ---
# sudo 헬퍼(root)로 compose를 실행하므로 ~ 대신 절대경로 필수(미설정 시 compose가 즉시 실패)
DATA_DIR=/home/jb/srv/smartfarm

# --- backend: DB 연결 ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db-postgres:5432/smartfarm_service
SPRING_DATASOURCE_USERNAME=smartfarm_app
SPRING_DATASOURCE_PASSWORD=change-me

# --- backend: 인증 ---
JWT_SECRET=change-me-to-a-long-random-base64-value

# --- backend: CORS(콤마 구분 오리진 목록) ---
CORS_ALLOWED_ORIGINS=https://farm-home.luma200ok.com

# --- backend: AI 서버 연동 ---
AI_SERVER_URL=http://smartfarm-ai:8000

# --- frontend 빌드 인자: 브라우저에서 호출할 공개 API 베이스 URL ---
PUBLIC_URL=https://farm-home.luma200ok.com

# --- cloudflared: Cloudflare Tunnel 토큰(Zero Trust 대시보드에서 발급) ---
TUNNEL_TOKEN=change-me

# --- backend: KMA 단기예보(#56) — 공공데이터포털 인증키(디코딩 키)와 격자 좌표 ---
# 실제 값은 smartfarm-ai 스택 .env의 KMA_SERVICE_KEY와 동일한 것을 쓴다(서버에서 값 복사).
KMA_SERVICE_KEY=your-kma-service-key
KMA_GRID_NX=60
KMA_GRID_NY=127
